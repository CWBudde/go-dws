type TBool = function: Boolean;
var calls := '';
function Yes: Boolean;
begin
   calls += 'Y';
   Result := True;
end;
function No: Boolean;
begin
   calls += 'N';
   Result := False;
end;
var yesPtr: TBool := @Yes;
var noPtr: TBool := @No;
PrintLn(yesPtr and noPtr);
PrintLn(calls);
calls := '';
PrintLn(noPtr and yesPtr);
PrintLn(calls);
calls := '';
PrintLn(noPtr or yesPtr);
PrintLn(calls);
calls := '';
PrintLn(yesPtr or noPtr);
PrintLn(calls);
calls := '';
PrintLn(yesPtr and True);
PrintLn(True and yesPtr);
PrintLn(noPtr or False);
PrintLn(False or noPtr);
PrintLn(calls);
calls := '';
PrintLn(Yes and No);
PrintLn(No or Yes);
PrintLn(calls);
var closure: TBool := lambda => True;
PrintLn(closure and closure);
PrintLn(False or closure);
var copy: TBool := yesPtr;
calls := '';
PrintLn(calls = '');
PrintLn(copy implies yesPtr);
PrintLn(calls);
