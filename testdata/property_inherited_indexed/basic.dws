type TBase = class
 function Get(I: Integer): Integer; begin Result := 10+I; end;
 property Prop[I: Integer]: Integer read Get reintroduce; default;
 property Plain[I: Integer]: Integer read Get;
end;
type TChild = class(TBase)
 function Read: Integer;
 begin Result := inherited Prop()[1]+inherited Prop[2]+inherited Plain[3]; end;
end;
PrintLn(TChild.Create.Read);
