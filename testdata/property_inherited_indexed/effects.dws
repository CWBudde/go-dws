type TTest = class
 function Get(I, J: Integer): Integer; begin PrintLn('getter'); Result := I*10+J; end;
 property Prop[I, J: Integer]: Integer read Get reintroduce;
 function First: Integer; begin PrintLn('first'); Result := 2; end;
 function Second: Integer; begin PrintLn('second'); Result := 7; end;
end;
type TLexical = class(TTest)
 function Read: Integer; begin Result := inherited Prop()[First, Second]; end;
end;
PrintLn(TLexical.Create.Read);
