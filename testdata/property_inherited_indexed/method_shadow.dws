type TAncestor = class
 function Get(I: Integer): Integer; begin Result := I+10; end;
 property Prop[I: Integer]: Integer read Get reintroduce;
end;
type TBase = class(TAncestor)
 function Prop: array of Integer; reintroduce; begin Result := [40, 50]; end;
end;
type TChild = class(TBase)
 function Read: Integer; begin Result := inherited Prop()[1]; end;
end;
PrintLn(TChild.Create.Read);
