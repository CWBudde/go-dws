type TTest = class
 function Get(I: Integer): Integer; begin raise Exception.Create('getter'); end;
 property Prop[I: Integer]: Integer read Get reintroduce;
end;
type TLexical = class(TTest)
 function Read: Integer; begin Result := inherited Prop()[2]; end;
end;
try PrintLn(TLexical.Create.Read); except on E: Exception do PrintLn(E.Message); end;
PrintLn('after');
