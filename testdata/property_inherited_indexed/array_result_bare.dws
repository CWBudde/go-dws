type TInts = array of Integer;
var Calls: Integer;
type TTest = class
 function Get(I, J: Integer): TInts; begin Inc(Calls); Result := [I+J, I*J]; end;
 property Prop[I, J: Integer]: TInts read Get reintroduce;
end;
type TLexical = class(TTest)
 function Read: Integer; begin Result := inherited Prop[2, 3][1]; end;
end;
PrintLn(TLexical.Create.Read); PrintLn(Calls);
