type T = class
 F: Integer;
 property P: Integer read F write F description "first
second ""quoted""";
 property Compat: Integer read F description "first
second ""quoted""" reintroduce;
 function GetItem(I: Integer): Integer; begin Result := F+I; end;
 property Items[I: Integer]: Integer read GetItem description "first
second ""quoted"""; default;
end;
var O := new T;
O.P := 7;
PrintLn(O.P);
PrintLn(O.Compat());
