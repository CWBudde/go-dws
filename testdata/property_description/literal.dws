type T = class
 F: Integer;
 property P: Integer read F write F description 'a description';
 property Compat: Integer read F description 'a description' reintroduce;
 function GetItem(I: Integer): Integer; begin Result := F+I; end;
 property Items[I: Integer]: Integer read GetItem description 'a description'; default;
end;
var O := new T;
O.P := 7;
PrintLn(O.P);
PrintLn(O.Compat());
PrintLn(O[3]);
