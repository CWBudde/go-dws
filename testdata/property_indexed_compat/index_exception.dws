type TTest = class
 function Get(I, J: Integer): Integer;
 begin PrintLn('unexpected getter'); Result := I+J; end;
 property Prop[I, J: Integer]: Integer read Get reintroduce;
end;
var Obj := new TTest;
function First: Integer; begin raise Exception.Create('index'); end;
function Second: Integer; begin PrintLn('unexpected second'); Result := 7; end;
try PrintLn(Obj.Prop()[First, Second]); except on E: Exception do PrintLn(E.Message); end;
