type TBase = class
 function Get(I: Integer): Integer; begin Result := 10+I; end;
 property Prop[I: Integer]: Integer read Get reintroduce;
 function Read: Integer; begin Result := Prop()[3]; end;
end;
type TChild = class(TBase)
 function Prop: array of Integer; begin Result := [8, 9]; end;
 function ReadChild: Integer; begin Result := Prop()[1]; end;
end;
var Obj := new TChild;
PrintLn(Obj.Read); PrintLn(Obj.ReadChild);
