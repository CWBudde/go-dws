type TInts = array of Integer;
function Prop: TInts; begin Result := [98, 99]; end;
type TTest = class
 function Get(I: Integer): Integer; begin Result := 10+I; end;
 property Prop[I: Integer]: Integer read Get reintroduce;
 function Read: Integer; begin Result := Prop()[3]; end;
end;
PrintLn(TTest.Create.Read); PrintLn(Prop()[1]);
