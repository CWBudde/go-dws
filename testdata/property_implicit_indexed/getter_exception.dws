type TTest = class
 function Get(I: Integer): Integer; begin raise Exception.Create('getter'); end;
 property Prop[I: Integer]: Integer read Get reintroduce;
 function Read: Integer; begin Result := Prop()[2]; end;
end;
try PrintLn(TTest.Create.Read); except on E: Exception do PrintLn(E.Message); end;
PrintLn('after');
