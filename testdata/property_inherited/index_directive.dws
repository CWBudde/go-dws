type TBase = class
 function Get(I: Integer): Integer; begin Result := I * 10; end;
 property Prop: Integer index 3 read Get reintroduce;
end;
type TChild = class(TBase)
 function Probe: Integer; begin Result := inherited Prop + inherited Prop(); end;
end;
var Obj := new TChild; PrintLn(Obj.Probe());
